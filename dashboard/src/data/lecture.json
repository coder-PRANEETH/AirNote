  "speech": [
    {
      "t": 21,
      "text": "Newton's second law states that force is equal to mass times acceleration."
    },
    {
      "t": 35,
      "text": "Now let's rearrange the equation to find acceleration."
    },
    {
      "t": 48,
      "text": "This gives us acceleration equals force divided by mass."
    },
    {
      "t": 62,
      "text": "So a heavier object needs more force for the same acceleration."
    }
  ],
